CI_ENVIRONMENT = development

# CodeIgniter 4 - Configured for cabutad.free.nf
app.baseURL = 'https://cabutad.free.nf/'
app.defaultIndexEnabled = true

# Database - SQLite (file-based, works without MySQL on InfinityFree)
database.default.hostname = localhost
database.default.database = writable/database.sqlite
database.default.username = root
database.default.password =
database.default.DBDriver = SQLite3
database.default.DBPrefix =
database.default.port = 3306

# Development settings
CI_DEBUG = 2
ENV</arg_value<arg_key>timeout</arg_key><arg_value>10
